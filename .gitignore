__pycache__
.DS_Store
# Environment files. Glob rather than exact names, so variants like
# .env.prod.server or .env.local are covered too. Only the committed
# *.example templates are exempt.
.env*
!.env.example
!.env.test.example
!*.env.example
!.env.poc.example

# Conductor personal/per-machine overrides (settings.toml IS committed)
.conductor/settings.local.toml

# logs and run directory on production
/logs/
/run/
infrastructure/
prd/
.vercel

.devcontainer/install.local.sh
venv/
.venv/
.playwright-mcp
coturn/
*.wav
dograh_pcm_cache/
node_modules/

# Homelab-local POC build/runtime artifacts. Reusable deployment sources belong
# under deploy/poc-asterisk; these root paths contain generated binaries and
# machine-specific overrides.
/asterisk/
/asterisk-build/
/asterisk-poc.service
/compose.homelab.yaml

# Superpowers brainstorm mockups (local only)
.superpowers/
docs/superpowers/
.gstack/
